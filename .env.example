PIMS_DATABASE_URL=sqlite:///./data/pims.db
PIMS_CACHE_ROOT=./data/.cache
PIMS_QUARANTINE_ROOT=./data/.quarantine
PIMS_LOGS_ROOT=./data/logs
PIMS_KEEP_ROOT=
PIMS_API_TOKEN=
PIMS_DEEPSEEK_API_KEY=
PIMS_DEEPSEEK_BASE_URL=https://api.deepseek.com
PIMS_DEEPSEEK_MODEL=deepseek-chat
PIMS_WECHAT_WEBHOOK_URL=
# Max WeChat messages per rolling hour (0 disables the cap).
PIMS_WECHAT_HOURLY_LIMIT=3
# 1 = queue batch notifications and send one daily digest from the workflow.
PIMS_WECHAT_DIGEST=0
# NSFW backend for R18 scans: heuristic (default) or onnx (local NudeNet model).
PIMS_NSFW_BACKEND=heuristic
# Model file for the onnx backend; download via scripts/download_nsfw_model.py.
PIMS_NSFW_ONNX_MODEL_PATH=./data/models/nudenet_classifier_model.onnx
